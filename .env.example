# ═══════════════════════════════════════════════════════
# AgentHook — Required Environment Variables
# ═══════════════════════════════════════════════════════
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# Need X Layer testnet ETH? Use faucet:
#   https://www.okx.com/faucet
# ═══════════════════════════════════════════════════════

# === REQUIRED ===

# Your deployer wallet private key (with 0x prefix)
# Get from: wallet → settings → export private key
# ⚠️ KEEP THIS SECRET — never commit .env to git
PRIVATE_KEY=0xabc123def456abc123def456abc123def456abc123def456abc123def456abc1

# === OPTIONAL (with defaults) ===

# Agent wallet address — defaults to deployer address if not set
# Use if you want the agent wallet to be different from deployer
# AGENT_WALLET=0xYourAgentWalletAddressHere

# Agent name — shown on dashboard
AGENT_NAME=MyAgent

# Agent description — what your agent does
AGENT_DESC=AI agent managing its own Uniswap V4 pool on X Layer

# Initial fee in basis points. Default: 30 (0.30%)
# Range: 1-1000 (0.01% to 10%)
# Common values:
#   1   = 0.01% (stable pairs)
#   5   = 0.05% (stable-volatile)
#   30  = 0.30% (standard)
#   100 = 1.00% (exotic pairs)
# AGENT_FEE=30

# X Layer RPC URL (mainnet)
XLAYER_RPC_URL=https://rpc.xlayer.tech
