# ═══════════════════════════════════════════════════════
# AgentYield — AI Agent Yield Engine
# ═══════════════════════════════════════════════════════
# Copy this to .env and fill in your values:
#   cp .env.example .env
# ═══════════════════════════════════════════════════════

# === REQUIRED ===

# Your wallet private key (for deploy + bot)
PRIVATE_KEY=0xabc123def456abc123def456abc123def456abc123def456abc123def456abc1

# AgentYield Factory address (set after deploying)
FACTORY_ADDRESS=0x...

# === OPTIONAL ===

# Specific agent hook to manage (if managing one agent)
# AGENT_HOOK=0x...

# X Layer RPC
XLAYER_RPC_URL=https://rpc.xlayer.tech
